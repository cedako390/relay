# Orchestrator configuration (copy to .env). All values are optional.

# Backend port. The host is always 127.0.0.1 (not configurable).
# If you change it, also change BACKEND in packages/web/vite.config.ts (dev proxy).
PORT=4180

# Where the database, access token, per-session configs and git worktrees live.
DATA_DIR=./data

# Command used to launch Claude Code in a PTY (resolved through PATH).
CLAUDE_BIN=claude

# Shell for terminal sessions and for the prompt left after Claude exits.
# Empty = powershell.exe on Windows, $SHELL (or /bin/bash) elsewhere.
SHELL_BIN=

# Optional --permission-mode for every session (e.g. acceptEdits). Empty = claude's own default.
CLAUDE_PERMISSION_MODE=

# Folder for tasks that were created without a known working directory. Empty = <DATA_DIR>/workspace.
DEFAULT_CWD=

# Auto-answer "Do you trust this folder?" with Yes for git worktrees the server creates itself
# (<DATA_DIR>/worktrees/<task-id>). Off by default; without it an unattended worker waits for you
# to confirm the dialog in its terminal. See README.
AUTO_TRUST_WORKTREES=false

# Disable Claude Code's built-in Agent (sub-agent) tool in panel sessions and tell the model to delegate
# through the orchestrator's create_task instead. Set to false to allow native sub-agents again.
BLOCK_NATIVE_SUBAGENTS=true

# Limits
MAX_WORKERS=4
MAX_DEPTH=3
# Orchestrators started by other orchestrators (create_orchestrator): active at once (0 = off) and nesting depth (user-opened session = 1).
MAX_SUB_ORCHESTRATORS=4
MAX_ORCHESTRATOR_DEPTH=2

# Comma-separated whitelist of model aliases; unknown requested models fall back to DEFAULT_MODEL.
ALLOWED_MODELS=haiku,sonnet,opus
# Empty = let claude choose its own default model.
DEFAULT_MODEL=

# Origins allowed to open WebSocket connections (comma-separated).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4180,http://localhost:4180

LOG_LEVEL=info
